APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
AGENT_MODE=mock
ALLOW_FIXTURES=true
PYTHON_BASE_URL=http://localhost:8000
PYTHON_INTERNAL_TOKEN=
UPSTREAM_TIMEOUT=20s
UPSTREAM_RESPONSE_LIMIT=8388608
HTTP_BODY_LIMIT=1048576
SHUTDOWN_TIMEOUT=10s
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DISPLAY_TIMEZONE=Asia/Almaty
MOCK_SCENARIO=success
MOCK_WORKERS=2
MOCK_QUEUE_CAPACITY=64
MOCK_MAX_JOBS=500
MOCK_MAX_EVENTS_PER_JOB=2000
MOCK_STEP_DELAY=100ms
SSE_HEARTBEAT_INTERVAL=15s
EVENT_POLL_INTERVAL=1s
SSE_WRITE_TIMEOUT=10s
SSE_MAX_STREAMS=64
TURBINE_1_LATITUDE=43.645150
TURBINE_1_LONGITUDE=78.535604
TURBINE_2_LATITUDE=43.643198
TURBINE_2_LONGITUDE=78.538828
